#usda 1.0
(
    defaultPrim = "table_GRP"
    doc = "Clean component, loaded as a payload by room_layout.usda."
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "table_GRP" (
    kind = "component"
)
{
    def Xform "geo_GRP"
    {
        def Mesh "top_GEO" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-60, 72, -40), (60, 76, 40)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            rel material:binding = </table_GRP/mtl/oak>
            point3f[] points = [(-60, 72, -40), (-60, 72, 40), (-60, 76, -40), (-60, 76, 40), (60, 72, -40), (60, 72, 40), (60, 76, -40), (60, 76, 40)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "leg1_GEO" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-58, 0, -38), (-53, 72, -33)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            rel material:binding = </table_GRP/mtl/oak>
            point3f[] points = [(-58, 0, -38), (-58, 0, -33), (-58, 72, -38), (-58, 72, -33), (-53, 0, -38), (-53, 0, -33), (-53, 72, -38), (-53, 72, -33)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "leg2_GEO" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(53, 0, -38), (58, 72, -33)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            rel material:binding = </table_GRP/mtl/oak>
            point3f[] points = [(53, 0, -38), (53, 0, -33), (53, 72, -38), (53, 72, -33), (58, 0, -38), (58, 0, -33), (58, 72, -38), (58, 72, -33)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "leg3_GEO" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-58, 0, 33), (-53, 72, 38)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            rel material:binding = </table_GRP/mtl/oak>
            point3f[] points = [(-58, 0, 33), (-58, 0, 38), (-58, 72, 33), (-58, 72, 38), (-53, 0, 33), (-53, 0, 38), (-53, 72, 33), (-53, 72, 38)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "leg4_GEO" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(53, 0, 33), (58, 72, 38)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            rel material:binding = </table_GRP/mtl/oak>
            point3f[] points = [(53, 0, 33), (53, 0, 38), (53, 72, 33), (53, 72, 38), (58, 0, 33), (58, 0, 38), (58, 72, 33), (58, 72, 38)]
            uniform token subdivisionScheme = "none"
        }
    }

    def Scope "mtl"
    {
        def Material "oak"
        {
            token outputs:surface.connect = </table_GRP/mtl/oak/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.42, 0.25)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }
}
